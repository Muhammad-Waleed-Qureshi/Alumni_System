# Copy this file to .env and replace the sample values.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-secret

# MySQL / XAMPP
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root
DB_NAME=alumni_db

# Administrator account (used for the management dashboard)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# SMTP settings (example: Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=Alumni Management System <your-email@example.com>
CONTACT_TO=your-email@example.com
